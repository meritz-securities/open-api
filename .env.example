# 메리츠증권 Open API 자격증명
#
#   cp .env.example .env && chmod 600 .env
#
# 개발자 포털에서 발급받은 앱키를 넣어 주세요.
# .env 는 저장소에 커밋되지 않습니다(.gitignore 에 들어 있습니다).

MERITZ_APP_KEY=
MERITZ_APP_SECRET=

# ── 호출 대상 서버 ────────────────────────────────────────────────
# 기본값은 운영 서버입니다.
# 아래 두 줄은 주석 처리되어 있으므로, 그대로 두시면 운영으로 나갑니다.
#
# 다른 서버로 붙으셔야 하면 두 줄을 함께 풀어 주소를 적어 주세요.
# 한쪽만 바꾸면 토큰과 실시간 구독이 서로 다른 서버로 나갑니다.
#
# MERITZ_BASE_URL=https://openapi.imeritz.com:9443
# MERITZ_WS_URL=wss://openapi.imeritz.com:29443/websocket

# ── 안전 스위치 ───────────────────────────────────────────────────
# 기본값은 1(조회 전용)입니다. 주문·환전을 쓰시려면 아래 줄을 풀어 0 으로 두세요.
# MERITZ_READ_ONLY=0

# 요청 제한시간(초). 기본 15
# MERITZ_TIMEOUT=15
